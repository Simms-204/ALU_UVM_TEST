# ============================================================
# Verilator Makefile for ALU UVM Project
# ============================================================

VERILATOR = verilator

# Find project root relative to this Makefile
PROJECT_ROOT = $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)

# UVM installation
UVM_HOME ?= $(HOME)/uvm/1800.2-2020.3.2/src


# ------------------------------------------------------------
# Include directories
# ------------------------------------------------------------
# The ALU DUT, interface, transaction, driver, monitors,
# scoreboard, env, test and top module all live in a single
# flat testbench file under tb/, so there is no separate
# rtl/, test/ or agent split to include.

INC = \
	+incdir+$(UVM_HOME) \
	+incdir+$(PROJECT_ROOT)/tb \
	+incdir+$(PROJECT_ROOT)/sim


# ------------------------------------------------------------
# Compile-time definitions
# ------------------------------------------------------------

DEFINES = \
	+define+UVM_NO_DPI


# ------------------------------------------------------------
# Source files
# ------------------------------------------------------------

UVM_SRC = $(UVM_HOME)/uvm_pkg.sv

# Single flat file: ALU DUT + ALU_IF + write_xtn + sequence +
# driver + monitors + sequencer + agent + scoreboard + env +
# base_test + module top
TB_SRC = \
	 $(PROJECT_ROOT)/tb/alu_uvm_tb_with_clock.sv


# ------------------------------------------------------------
# Verilator options
# ------------------------------------------------------------

VERILATOR_FLAGS = \
	-Wno-fatal \
	-Wno-TIMESCALEMOD \
	--timing \
	--coverage \
	--top-module top \
	-j $(shell nproc)


# ------------------------------------------------------------
# Coverage files and directories
# ------------------------------------------------------------

COVERAGE_DIR = $(PROJECT_ROOT)/coverage

BASE_COV = $(COVERAGE_DIR)/coverage_base.dat

MERGED_COV = $(COVERAGE_DIR)/merged.dat

ANNOTATED_DIR = $(COVERAGE_DIR)/annotated

SUMMARY_FILE = $(COVERAGE_DIR)/coverage_summary.txt


# ------------------------------------------------------------
# Targets
# ------------------------------------------------------------

.PHONY: help \
	lint \
	build \
	run \
	run_base \
	coverage_base \
	merge_coverage \
	coverage_report \
	coverage \
	clean


# ============================================================
# Help
# ============================================================

help:
	@echo ""
	@echo "============================================================"
	@echo " ALU - Verilator UVM Simulation"
	@echo "============================================================"
	@echo ""
	@echo "Simulation targets:"
	@echo ""
	@echo "  make -f sim/Makefile.verilator lint"
	@echo "      Run Verilator lint/checks only"
	@echo ""
	@echo "  make -f sim/Makefile.verilator build"
	@echo "      Build ALU DUT + UVM testbench with coverage enabled"
	@echo ""
	@echo "  make -f sim/Makefile.verilator run"
	@echo "      Run base_test"
	@echo ""
	@echo "  make -f sim/Makefile.verilator run_base"
	@echo "      Run base_test"
	@echo ""
	@echo "Coverage targets:"
	@echo ""
	@echo "  make -f sim/Makefile.verilator coverage_base"
	@echo "      Run base_test and generate coverage_base.dat"
	@echo ""
	@echo "  make -f sim/Makefile.verilator merge_coverage"
	@echo "      Merge coverage data (single-test project, but kept"
	@echo "      for consistency / future additional tests)"
	@echo ""
	@echo "  make -f sim/Makefile.verilator coverage_report"
	@echo "      Generate annotated coverage report and summary"
	@echo ""
	@echo "  make -f sim/Makefile.verilator coverage"
	@echo "      Run all coverage steps"
	@echo ""
	@echo "Other:"
	@echo ""
	@echo "  make -f sim/Makefile.verilator clean"
	@echo "      Remove generated Verilator and coverage files"
	@echo ""
	@echo "============================================================"
	@echo ""


# ============================================================
# Lint
# ============================================================

lint:
	$(VERILATOR) \
		$(VERILATOR_FLAGS) \
		--lint-only \
		$(INC) \
		$(DEFINES) \
		$(UVM_SRC) \
		$(TB_SRC)


# ============================================================
# Build
# ============================================================

build:
	$(VERILATOR) \
		$(VERILATOR_FLAGS) \
		--binary \
		$(INC) \
		$(DEFINES) \
		$(UVM_SRC) \
		$(TB_SRC)


# ============================================================
# Normal simulation
# ============================================================

run:
	./obj_dir/Vtop +UVM_TESTNAME=base_test

run_base:
	./obj_dir/Vtop +UVM_TESTNAME=base_test


# ============================================================
# Coverage run
# ============================================================
# The ALU testbench only defines one test class (base_test),
# which drives ADD/SUB/AND/OR through the randomized
# ALU_SEQUENCE, so there is a single coverage run rather than
# the per-burst-type runs used by the bridge project.

coverage_base:
	mkdir -p $(COVERAGE_DIR)
	./obj_dir/Vtop \
		+UVM_TESTNAME=base_test \
		+verilator+coverage+file+$(BASE_COV)


# ============================================================
# Merge coverage
# ============================================================
# Only one .dat file today, but kept as a real merge step so
# additional tests/sequences can be added later without
# reworking the flow.

merge_coverage:
	verilator_coverage \
		--write $(MERGED_COV) \
		$(BASE_COV)


# ============================================================
# Generate annotated coverage report
# ============================================================

coverage_report:
	rm -rf $(ANNOTATED_DIR)
	mkdir -p $(ANNOTATED_DIR)

	verilator_coverage \
		--annotate $(ANNOTATED_DIR) \
		$(MERGED_COV) \
		> $(SUMMARY_FILE)

	@echo ""
	@echo "============================================================"
	@echo " Coverage Report Generated"
	@echo "============================================================"
	@echo ""
	@echo "Summary:"
	@cat $(SUMMARY_FILE)
	@echo ""
	@echo "Summary file:"
	@echo "  $(SUMMARY_FILE)"
	@echo ""
	@echo "Annotated source:"
	@echo "  $(ANNOTATED_DIR)"
	@echo ""
	@echo "Merged coverage:"
	@echo "  $(MERGED_COV)"
	@echo ""
	@echo "============================================================"
	@echo ""


# ============================================================
# Complete coverage flow
# ============================================================

coverage: build coverage_base merge_coverage coverage_report


# ============================================================
# Clean
# ============================================================

clean:
	rm -rf obj_dir
	rm -rf $(COVERAGE_DIR)
