        `ifndef UVM_REPORT_SERVER_SVH
        `define UVM_REPORT_SERVER_SVH
        
        typedef class uvm_report_object;
        
        //------------------------------------------------------------------------------
        // Title -- NODOCS -- UVM Report Server
        //
        // This page covers the classes that define the UVM report server facility.
        //------------------------------------------------------------------------------
           
        //------------------------------------------------------------------------------
        //
        // CLASS -- NODOCS -- uvm_report_server
        //
        // uvm_report_server is a global server that processes all of the reports
        // generated by a uvm_report_handler. 
        //
        // The ~uvm_report_server~ is an abstract class which declares many of its methods
        // as ~pure virtual~.  The UVM uses the <uvm_default_report_server> class
        // as its default report server implementation.
        //------------------------------------------------------------------------------
        
        typedef class uvm_default_report_server;
        // @uvm-ieee 1800.2-2020 auto 6.5.1.1
        virtual class uvm_report_server extends uvm_object;
%000000         function string get_type_name();
%000000                 return "uvm_report_server";
                endfunction
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.1
%000003         function new(string name="base");
%000003                 super.new(name);
                endfunction
        
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.3
%000000         pure virtual  function void set_max_quit_count(int count, bit overridable = 1);
        
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.2
%000000         pure virtual  function int get_max_quit_count();
        
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.5
%000000         pure virtual  function void set_quit_count(int quit_count);
        
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.4
%000000         pure virtual  function int get_quit_count();
        
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.7
%000000         pure virtual  function void set_severity_count(uvm_severity severity, int count);
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.6
%000000         pure virtual  function int get_severity_count(uvm_severity severity);
        
                // Function -- NODOCS -- set_id_count
                // sets the count of already passed messages with ~id~ to ~count~
%000000         pure virtual  function void set_id_count(string id, int count);
        
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.8
%000000         pure virtual  function int get_id_count(string id);
        
        
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.9
%000000         pure virtual function void get_id_set(output string q[$]);
        
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.10
%000000         pure virtual function void get_severity_set(output uvm_severity q[$]);
        
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.12
%000000         pure virtual function void set_message_database(uvm_tr_database database);
        
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.11
%000000         pure virtual function uvm_tr_database get_message_database();
        
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.13
%000000         function void do_copy (uvm_object rhs);
%000000                 uvm_report_server rhs_;
        
%000000                 super.do_copy(rhs);
%000000                 if(!$cast(rhs_,rhs)) begin
%000000                   `uvm_error("UVM/REPORT/SERVER/RPTCOPY","cannot copy to report_server from the given datatype")
                        end
        
%000000                 begin
%000000                   uvm_severity q[$];
%000000                   rhs_.get_severity_set(q);
%000000                   foreach(q[s]) begin
                                        
%000000                     set_severity_count(q[s],rhs_.get_severity_count(q[s]));
                          end
        
                        end
        
%000000                 begin
%000000                   string q[$];
%000000                   rhs_.get_id_set(q);
%000000                   foreach(q[s]) begin
                                        
%000000                     set_id_count(q[s],rhs_.get_id_count(q[s]));
                          end
        
                        end
        
%000000                 set_message_database(rhs_.get_message_database());
%000000                 set_max_quit_count(rhs_.get_max_quit_count());
%000000                 set_quit_count(rhs_.get_quit_count());
                endfunction
        
        
                // Function- process_report_message
                //
                // Main entry for uvm_report_server, combines execute_report_message and compose_report_message
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.14
%000000         pure virtual function void process_report_message(uvm_report_message report_message);
        
        
                // Function -- NODOCS -- execute_report_message
                //
                // Processes the provided message per the actions contained within.
                //
                // Expert users can overload this method to customize action processing.
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.16
%000000         pure virtual function void execute_report_message(uvm_report_message report_message,
                                                                  string composed_message);
        
        
                // Function -- NODOCS -- compose_report_message
                //
                // Constructs the actual string sent to the file or command line
                // from the severity, component name, report id, and the message itself.
                //
                // Expert users can overload this method to customize report formatting.
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.15
%000000         pure virtual function string compose_report_message(uvm_report_message report_message,
 002630                                                             string report_object_name = "");
        
        
                // Function -- NODOCS -- report_summarize
                //
                // Outputs statistical information on the reports issued by this central report
                // server. This information will be sent to the command line if ~file~ is 0, or
                // to the file descriptor ~file~ if it is not 0.
                //
                // The <run_test> method in uvm_top calls this method.
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.17
%000000         pure virtual function void report_summarize(UVM_FILE file = UVM_STDOUT);
        
                // Function -- NODOCS -- set_server
                //
                // Sets the global report server to use for reporting.
                //
                // This method is provided as a convenience wrapper around
                // setting the report server via the <uvm_coreservice_t::set_report_server>
                // method.
                //
                // In addition to setting the server this also copies the severity/id counts
                // from the current report_server to the new one
                //
                // | // Using the uvm_coreservice_t:
                // | uvm_coreservice_t cs;
                // | cs = uvm_coreservice_t::get();
                // | your_server.copy(cs.get_report_server());
                // | cs.set_report_server(your_server);
                // |
                // | // Not using the uvm_coreservice_t:
                // | uvm_report_server::set_server(your_server);
           
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.19
%000000         static function void set_server(uvm_report_server server);
%000000             uvm_coreservice_t cs = uvm_coreservice_t::get();
%000000                 server.copy(cs.get_report_server());
%000000                 cs.set_report_server(server);
                endfunction
        
        
                // Function -- NODOCS -- get_server
                //
                // Gets the global report server used for reporting.
                //
                // This method is provided as a convenience wrapper
                // around retrieving the report server via the <uvm_coreservice_t::get_report_server>
                // method.
                //
                // | // Using the uvm_coreservice_t:
                // | uvm_coreservice_t cs;
                // | uvm_report_server rs;
                // | cs = uvm_coreservice_t::get();
                // | rs = cs.get_report_server();
                // |
                // | // Not using the uvm_coreservice_t:
                // | uvm_report_server rs;
                // | rs = uvm_report_server::get_server();
                //
        
                // @uvm-ieee 1800.2-2020 auto 6.5.1.2.18
 002642         static function uvm_report_server get_server();
 002642             uvm_coreservice_t cs = uvm_coreservice_t::get();
 002642                 return cs.get_report_server();
                endfunction
        
                // @uvm-compat Added for compatibility to uvm-1.1d
%000000         function void dump_server_state();
%000000           this.report_summarize();
                endfunction : dump_server_state
        endclass
        
        //------------------------------------------------------------------------------
        //
        // CLASS: uvm_default_report_server
        //
        // Default implementation of the UVM report server, as defined in section
        // 6.5.2 of 1800.2-2020
        //
        
        // @uvm-ieee 1800.2-2020 auto 6.5.2
        class uvm_default_report_server extends uvm_report_server;
        
          local int m_quit_count;
          local int m_max_quit_count; 
%000003   bit max_quit_overridable = 1;
          local int m_severity_count[uvm_severity];
          protected int m_id_count[string];
           protected uvm_tr_database m_message_db;
           protected uvm_tr_stream m_streams[string][string]; // ro.name,rh.name
           
        
          // Variable: enable_report_id_count_summary
          //
          // A flag to enable report count summary for each ID
          //
          // @uvm-accellera This API is specific to the Accellera implementation, and is not being considered for contribution to 1800.2
%000003   bit enable_report_id_count_summary=1;
        
        
          // Variable: record_all_messages
          //
          // A flag to force recording of all messages (add UVM_RM_RECORD action)
          //
          // @uvm-accellera This API is specific to the Accellera implementation, and is not being considered for contribution to 1800.2
%000003   bit record_all_messages = 0;
        
          
          // Variable: show_verbosity
          //
          // A flag to include verbosity in the messages, e.g.
          // 
          // "UVM_INFO(UVM_MEDIUM) file.v(3) @ 60: reporter [ID0] Message 0"
          //
          // @uvm-accellera This API is specific to the Accellera implementation, and is not being considered for contribution to 1800.2
%000003   bit show_verbosity = 0;
        
        
          // Variable: show_terminator
          //
          // A flag to add a terminator in the messages, e.g.
          // 
          // "UVM_INFO file.v(3) @ 60: reporter [ID0] Message 0 -UVM_INFO"
          //
          // @uvm-accellera This API is specific to the Accellera implementation, and is not being considered for contribution to 1800.2
%000003   bit show_terminator = 0;
        
          // Needed for callbacks
%000000   function string get_type_name();
%000000     return "uvm_default_report_server";
          endfunction
        
        
          // Function --NODOCS-- new
          //
          // Creates an instance of the class.
        
%000003   function new(string name = "uvm_report_server");
%000003     super.new(name);
%000003     set_max_quit_count(0);
%000003     reset_quit_count();
%000003     reset_severity_counts();
          endfunction
        
        
          // Function --NODOCS-- print
          //
          // The uvm_report_server implements the <uvm_object::do_print()> such that
          // ~print~ method provides UVM printer formatted output
          // of the current configuration.  A snippet of example output is shown here:
          //
          // |uvm_report_server                 uvm_report_server  -     @13  
          // |  quit_count                      int                32    'd0  
          // |  max_quit_count                  int                32    'd5  
          // |  max_quit_overridable            bit                1     'b1  
          // |  severity_count                  severity counts    4     -    
          // |    [UVM_INFO]                    integral           32    'd4  
          // |    [UVM_WARNING]                 integral           32    'd2  
          // |    [UVM_ERROR]                   integral           32    'd50 
          // |    [UVM_FATAL]                   integral           32    'd10 
          // |  id_count                        id counts          4     -    
          // |    [ID1]                         integral           32    'd1  
          // |    [ID2]                         integral           32    'd2  
          // |    [RNTST]                       integral           32    'd1  
          // |  enable_report_id_count_summary  bit                1     'b1  
          // |  record_all_messages             bit                1     `b0
          // |  show_verbosity                  bit                1     `b0
          // |  show_terminator                 bit                1     `b0
        
        
          // Print to show report server state
%000000   virtual function void do_print (uvm_printer printer);
        
%000000     uvm_severity l_severity_count_index;
%000000     string l_id_count_index;
        
%000000     printer.print_field("quit_count", m_quit_count, $bits(m_quit_count), UVM_DEC,
%000000       ".", "int");
%000000     printer.print_field("max_quit_count", m_max_quit_count,
%000000       $bits(m_max_quit_count), UVM_DEC, ".", "int");
%000000     printer.print_field("max_quit_overridable", max_quit_overridable,
%000000       $bits(max_quit_overridable), UVM_BIN, ".", "bit");
        
%000000     if (m_severity_count.first(l_severity_count_index)) begin
%000000       printer.print_array_header("severity_count",m_severity_count.size(),"severity counts");
%000000       do begin
                
%000000         printer.print_field($sformatf("[%s]",l_severity_count_index.name()),
%000000           m_severity_count[l_severity_count_index], 32, UVM_DEC);
              end
        
%000000       while (m_severity_count.next(l_severity_count_index));
%000000       printer.print_array_footer();
            end
        
%000000     if (m_id_count.first(l_id_count_index)) begin
%000000       printer.print_array_header("id_count",m_id_count.size(),"id counts");
%000000       do begin
                
%000000         printer.print_field($sformatf("[%s]",l_id_count_index),
%000000           m_id_count[l_id_count_index], 32, UVM_DEC);
              end
        
%000000       while (m_id_count.next(l_id_count_index));
%000000       printer.print_array_footer();
            end
        
%000000     printer.print_field("enable_report_id_count_summary", enable_report_id_count_summary,
%000000       $bits(enable_report_id_count_summary), UVM_BIN, ".", "bit");
%000000     printer.print_field("record_all_messages", record_all_messages,
%000000       $bits(record_all_messages), UVM_BIN, ".", "bit");
%000000     printer.print_field("show_verbosity", show_verbosity,
%000000       $bits(show_verbosity), UVM_BIN, ".", "bit");
%000000     printer.print_field("show_terminator", show_terminator,
%000000       $bits(show_terminator), UVM_BIN, ".", "bit");
        
          endfunction
        
        
          //----------------------------------------------------------------------------
          // Group --NODOCS-- Quit Count
          //----------------------------------------------------------------------------
        
        
          // Function --NODOCS-- get_max_quit_count
        
%000000   function int get_max_quit_count();
%000000     return m_max_quit_count;
          endfunction
        
          // Function --NODOCS-- set_max_quit_count
          //
          // Get or set the maximum number of COUNT actions that can be tolerated
          // before a UVM_EXIT action is taken. The default is 0, which specifies
          // no maximum.
        
%000003   function void set_max_quit_count(int count, bit overridable = 1);
%000003     if (max_quit_overridable == 0) begin
%000000       uvm_report_info("NOMAXQUITOVR", 
%000000         $sformatf("The max quit count setting of %0d is not overridable to %0d due to a previous setting.", 
%000000         m_max_quit_count, count), UVM_NONE);
%000000       return;
            end
%000003     max_quit_overridable = overridable;
%000003     m_max_quit_count = count < 0 ? 0 : count;
          endfunction
        
        
          // Function --NODOCS-- get_quit_count
        
%000000   function int get_quit_count();
%000000     return m_quit_count;
          endfunction
        
          // Function --NODOCS-- set_quit_count
        
%000000   function void set_quit_count(int quit_count);
%000000     m_quit_count = quit_count < 0 ? 0 : quit_count;
          endfunction
        
          // Function --NODOCS-- incr_quit_count
        
          //@uvm-compat provided for compatibility with 1.2
%000000   function void incr_quit_count();
%000000     m_quit_count++;
          endfunction
        
          // Function --NODOCS-- reset_quit_count
          //
          // Set, get, increment, or reset to 0 the quit count, i.e., the number of
          // COUNT actions issued.
        
          //@uvm-compat provided for compatibility with 1.2
%000003   function void reset_quit_count();
%000003     m_quit_count = 0;
          endfunction
        
          // Function --NODOCS-- is_quit_count_reached
          //
          // If is_quit_count_reached returns 1, then the quit counter has reached
          // the maximum.
        
          //@uvm-compat provided for compatibility with 1.2
%000000   function bit is_quit_count_reached();
%000000     return (m_quit_count >= m_max_quit_count);
          endfunction
        
        
          //----------------------------------------------------------------------------
          // Group --NODOCS-- Severity Count
          //----------------------------------------------------------------------------
         
        
          // Function --NODOCS-- get_severity_count
        
%000003   function int get_severity_count(uvm_severity severity);
%000003     return m_severity_count[severity];
          endfunction
        
          // Function --NODOCS-- set_severity_count
        
%000000   function void set_severity_count(uvm_severity severity, int count);
%000000     m_severity_count[severity] = count < 0 ? 0 : count;
          endfunction
        
          // Function --NODOCS-- incr_severity_count
        
          //@uvm-compat provided for compatibility with 1.2
 002630   function void incr_severity_count(uvm_severity severity);
 002630     m_severity_count[severity]++;
          endfunction
        
          // Function --NODOCS-- reset_severity_counts
          //
          // Set, get, or increment the counter for the given severity, or reset
          // all severity counters to 0.
        
          //@uvm-compat provided for compatibility with 1.2
%000003   function void reset_severity_counts();
%000003     uvm_severity s;
%000003     s = s.first();
%000009     forever begin
%000009       m_severity_count[s] = 0;
%000009       if(s == s.last()) begin
%000000         break;
              end
        
%000009       s = s.next();
            end
          endfunction
        
        
          //----------------------------------------------------------------------------
          // Group --NODOCS-- id Count
          //----------------------------------------------------------------------------
        
        
          // Function --NODOCS-- get_id_count
        
%000000   function int get_id_count(string id);
%000000     if(m_id_count.exists(id)) begin
              
%000000       return m_id_count[id];
            end
        
%000000     return 0;
          endfunction
        
          // Function --NODOCS-- set_id_count
        
          //@uvm-compat provided for compatibility with 1.2
%000000   function void set_id_count(string id, int count);
%000000     m_id_count[id] = count < 0 ? 0 : count;
          endfunction
        
          // Function --NODOCS-- incr_id_count
          //
          // Set, get, or increment the counter for reports with the given id.
        
          //@uvm-compat provided for compatibility with 1.2
 002630   function void incr_id_count(string id);
 002589     if(m_id_count.exists(id)) begin
              
 002589       m_id_count[id]++;
            end
        
 000041     else begin
              
 000041       m_id_count[id] = 1;
            end
        
          endfunction
        
          //----------------------------------------------------------------------------
          // Group --NODOCS-- message recording
          //
          // The ~uvm_default_report_server~ will record messages into the message
          // database, using one transaction per message, and one stream per report
          // object/handler pair.
          //
          //----------------------------------------------------------------------------
        
           // Function --NODOCS-- set_message_database
           // sets the <uvm_tr_database> used for recording messages
%000000    virtual function void set_message_database(uvm_tr_database database);
%000000       m_message_db = database;
           endfunction : set_message_database
        
           // Function --NODOCS-- get_message_database
           // returns the <uvm_tr_database> used for recording messages
           //
%000000    virtual function uvm_tr_database get_message_database();
%000000       return m_message_db;
           endfunction : get_message_database
        
        
%000000   virtual function void get_severity_set(output uvm_severity q[$]);
%000000     foreach(m_severity_count[idx]) begin
              
%000000       q.push_back(idx);
            end
        
          endfunction
        
        
%000000   virtual function void get_id_set(output string q[$]);
%000000     foreach(m_id_count[idx]) begin
              
%000000       q.push_back(idx);
            end
        
          endfunction
        
        
          // Function- f_display
          //
          // This method sends string severity to the command line if file is 0 and to
          // the file(s) specified by file if it is not 0.
        
%000000   function void f_display(UVM_FILE file, string str);
%000000     if (file == 0) begin
              
%000000       $display("%s", str);
            end
        
%000000     else begin
              
%000000       $fdisplay(file, "%s", str);
            end
        
          endfunction
        
        
          // Function- process_report_message
          //
          //
        
 002630   virtual function void process_report_message(uvm_report_message report_message);
        
 002630     uvm_report_handler l_report_handler = report_message.get_report_handler();
 002630         process p = process::self();
 002630     bit report_ok = 1;
        
            // Set the report server for this message
 002630     report_message.set_report_server(this);
        
            // this functionality provided for backward compatibility with 1.1d
~002630     if(report_message.get_action() & UVM_CALL_HOOK) begin
              
%000000       report_ok = l_report_handler.run_hooks(
%000000         report_message.get_report_object(),
%000000         report_message.get_severity(), 
%000000         report_message.get_id(), 
%000000         report_message.get_message(), 
%000000         report_message.get_verbosity(), 
%000000         report_message.get_filename(), 
%000000         report_message.get_line());
            end
        
        
~002630     if(report_ok) begin
              
 002630       report_ok = uvm_report_catcher::process_all_report_catchers(report_message);
            end
        
        
~002630     if(uvm_action_type'(report_message.get_action()) == UVM_NO_ACTION) begin
              
%000000       report_ok = 0;
            end
        
        
~002630     if(report_ok) begin    
 002630       string m;
 002630       uvm_coreservice_t cs = uvm_coreservice_t::get();
              // give the global server a chance to intercept the calls
 002630       uvm_report_server svr = cs.get_report_server();
        
              // no need to compose when neither UVM_DISPLAY nor UVM_LOG is set
~002630       if (report_message.get_action() & (UVM_LOG|UVM_DISPLAY)) begin
                
 002630         m = svr.compose_report_message(report_message);
              end
        
        
 002630       svr.execute_report_message(report_message, m);
            end
        
          endfunction
        
        
          //----------------------------------------------------------------------------
          // Group --NODOCS-- Message Processing
          //----------------------------------------------------------------------------
        
        
          // Function --NODOCS-- execute_report_message
          //
          // Processes the provided message per the actions contained within.
          //
          // Expert users can overload this method to customize action processing.
         
 002630   virtual function void execute_report_message(uvm_report_message report_message,
                                                       string composed_message);
                                                       
 002630                                                process p = process::self();
                                                       
            // Update counts 
 002630     incr_severity_count(report_message.get_severity());
 002630     incr_id_count(report_message.get_id());
        
~002630     if (record_all_messages) begin
              
%000000       report_message.set_action(report_message.get_action() | UVM_RM_RECORD);
            end
        
        
            // UVM_RM_RECORD action
~002630     if(report_message.get_action() & UVM_RM_RECORD) begin
%000000       uvm_tr_stream stream;
%000000       uvm_report_object ro = report_message.get_report_object();
%000000       uvm_report_handler rh = report_message.get_report_handler();
        
              // Check for pre-existing stream
%000000       if (m_streams.exists(ro.get_name()) && (m_streams[ro.get_name()].exists(rh.get_name()))) begin
                 
%000000         stream = m_streams[ro.get_name()][rh.get_name()];
              end
        
        
              // If no pre-existing stream (or for some reason pre-existing stream was ~null~)
%000000       if (stream == null) begin
%000000         uvm_tr_database db;
        
                // Grab the database
%000000         db = get_message_database();
        
                // If database is ~null~, use the default database
%000000         if (db == null) begin
%000000           uvm_coreservice_t cs = uvm_coreservice_t::get();
%000000           db = cs.get_default_tr_database();
                end
%000000         if (db != null) begin
                  // Open the stream.  Name=report object name, scope=report handler name, type=MESSAGES
%000000           stream = db.open_stream(ro.get_name(), rh.get_name(), "MESSAGES");
                  // Save off the openned stream
%000000           m_streams[ro.get_name()][rh.get_name()] = stream;
                end
              end
%000000       if (stream != null) begin
%000000         uvm_recorder recorder = stream.open_recorder(report_message.get_name(),,report_message.get_type_name());
%000000         if (recorder != null) begin
%000000           report_message.record(recorder);
%000000           recorder.free();
                end
              end
            end
        
            // DISPLAY action
~002630     if(report_message.get_action() & UVM_DISPLAY) begin
              
 002630       $display("%s", composed_message);
            end
        
        
            // LOG action
            // if log is set we need to send to the file but not resend to the
            // display. So, we need to mask off stdout for an mcd or we need
            // to ignore the stdout file handle for a file handle.
~002630     if(report_message.get_action() & UVM_LOG) begin
              
%000000       if( (report_message.get_file() == 0) || 
%000000       (report_message.get_file() != 32'h8000_0001) ) begin //ignore stdout handle
%000000         UVM_FILE tmp_file = report_message.get_file();
%000000         if((report_message.get_file() & 32'h8000_0000) == 0) begin //is an mcd so mask off stdout
%000000           tmp_file = report_message.get_file() & 32'hffff_fffe;
                end
%000000         f_display(tmp_file, composed_message);
              end
            end
            
        
            // Process the UVM_COUNT action
~002630     if(report_message.get_action() & UVM_COUNT) begin
%000000       if(get_max_quit_count() != 0) begin
%000000         incr_quit_count();
                // If quit count is reached, add the UVM_EXIT action.
%000000         if(is_quit_count_reached()) begin
%000000           report_message.set_action(report_message.get_action() | UVM_EXIT);
                end
              end  
            end
        
            // Process the UVM_EXIT action
~002630     if(report_message.get_action() & UVM_EXIT) begin
%000000       uvm_root l_root;
%000000       uvm_coreservice_t cs;
%000000       cs = uvm_coreservice_t::get();
%000000       l_root = cs.get_root();
%000000       l_root.die();
            end
        
            // Process the UVM_STOP action
 002630     if (report_message.get_action() & UVM_STOP) begin 
              
              $stop;
            end
        
        
          endfunction
        
        
          // Function: compose_report_message
          //
          // Constructs the actual string sent to the file or command line
          // from the report message. 
          //
          // The return value is constructed by concatenating the following strings in order,
          // with spaces between.
          //
          //   Severity and verbosity - If <show_verbosity> is '1', then this value is the concatenation
          //                            of {S1,"(",S2,")"}, where ~S1~ is the severity of the message as
          //                            returned by <uvm_report_message::get_severity>, and ~S2~ is the
          //                            verbosity of the message, as returned by <uvm_report_message::get_verbosity>.
          //                            If <show_verbosity> is '0', then this value is simply the severity
          //                            of the message.
          //
          //   File name and line - If <uvm_report_message::get_filename> returns an empty string (""), 
          //                        then this value is the empty string ("").  Otherwise
          //                        this string is formatted as "%s(%0d)", where ~%s~ is the file
          //                        name, and ~%0d~ is the line number.
          //
          //   Timestamp - This value is the concatenation of {"@",TIME,":"}, where ~TIME~ is determined by formatting 
          //               ~$time~ as "%0t".  Note that ~$time~ is being resolved inside of the <uvm_pkg> scope.
          //
          //   Full report context - If <uvm_report_message::get_context>, returns an empty string (""), then 
          //                         this value is the full name of the report object returned by 
          //                         <uvm_report_message::get_report_object>.  Otherwise this
          //                         value is the the concatenation of {S1,"@@",S2}, where ~S1~ is the full
          //                         name of the report object for the message, and ~S2~ is
          //                         the context string.
          //
          //   ID - The concatenation of {"[", ID, "]"}, where ~ID~ is the return value of  <uvm_report_message::get_id>.
          //
          //   Message - The message string, as determined by <uvm_report_message::get_message>
          //
          //   Terminator - If <show_terminator> is '1', then the terminator string is {"-", SEV}, where ~SEV~ is 
          //                the severity as determined by <uvm_report_message::get_severity>.  If show_terminator is 
          //                '0', then this is the empty string ("").
          //   
          //For example, the following report messages...
          //|   `uvm_info("Example", "Info message", UVM_LOW) 
          //|   uvm_report_info("Example", "No file/line");
          //|   uvm_report_info("Example", "With context", UVM_LOW, 
          //|                   "demo_pkg.sv", 57, "example_context");
          //|
          //|   // show_verbosity = 1
          //|   `uvm_info("Example", "With verbosity", UVM_LOW)
          //|   // show_terminator = 1
          //|   `uvm_info("Example", "With terminator", UvM_LOW)
          //|   // show_verbosity = 1, show_terminator = 1
          //|   `uvm_info("Example", "With both", UVM_NONE)
          // 
          //...result in the output below
          //|
          //|  UVM_INFO demo_pkg.sv(55) @ 0: uvm_test_top [Example] Info message
          //|  UVM_INFO @ 0: uvm_test_top [Example] No file/line
          //|  UVM_INFO demo_pkg.sv(57) @ 0: uvm_test_top@@example_context [Example] With context
          //|
          //|  // show_verbosity = 1
          //|  UVM_INFO(UVM_LOW) demo_pkg.sv(60) @ 0: uvm_test_top [Example] Info message
          //|  // show_terminator = 1
          //|  UVM_INFO demo_pkg.sv(62) @ 0: uvm_test_top [Example] Info message -UVM_INFO
          //|  // show_verbosity = 1, show_terminator = 1
          //|  UVM_INFO(UVM_NONE) demo_pkg.sv(64) @ 0: uvm_test_top [Example] With both -UVM_INFO
          //
          // @uvm-accellera The details of this API are specific to the Accellera implementation, and are not being considered for contribution to 1800.2
          
 002630   virtual function string compose_report_message(uvm_report_message report_message,
                                                         string report_object_name = "");
        
 002630     string sev_string;
 002630     uvm_severity l_severity;
 002630     uvm_verbosity l_verbosity;
 002630     string filename_line_string;
 002630     string time_str;
 002630     string line_str;
 002630     string context_str;
 002630     string verbosity_str;
 002630     string terminator_str;
 002630     string msg_body_str;
 002630     uvm_report_message_element_container el_container;
 002630     string prefix;
 002630     uvm_report_handler l_report_handler;
        
 002630     l_severity = report_message.get_severity();
 002630     sev_string = l_severity.name();
        
~002627     if (report_message.get_filename() != "") begin
 002627       line_str.itoa(report_message.get_line());
 002627       filename_line_string = {report_message.get_filename(), "(", line_str, ") "};
            end
        
            // Make definable in terms of units.
 002630     $swrite(time_str, "%0t", $realtime);
         
 002597     if (report_message.get_context() != "") begin
              
 000033       context_str = {"@@", report_message.get_context()};
            end
        
        
~002630     if (show_verbosity) begin
%000000       if ($cast(l_verbosity, report_message.get_verbosity())) begin
                
%000000         verbosity_str = l_verbosity.name();
              end
        
%000000       else begin
                
%000000         verbosity_str.itoa(report_message.get_verbosity());
              end
        
%000000       verbosity_str = {"(", verbosity_str, ")"};
            end
        
~002630     if (show_terminator) begin
              
%000000       terminator_str = {" -",sev_string};
            end
        
        
 002630     el_container = report_message.get_element_container();
~002630     if (el_container.size() == 0) begin
              
 002630       msg_body_str = report_message.get_message();
            end
        
%000000     else begin
%000000       uvm_printer uvm_default_printer = uvm_printer::get_default() ;
%000000       prefix = uvm_default_printer.get_line_prefix();
%000000       uvm_default_printer.set_line_prefix(" +");
%000000       msg_body_str = {report_message.get_message(), "\n", el_container.sprint()};
%000000       uvm_default_printer.set_line_prefix(prefix);
            end
        
~002630     if (report_object_name == "") begin
 002630       l_report_handler = report_message.get_report_handler();
 002630       report_object_name = l_report_handler.get_full_name();
            end
        
 002630     compose_report_message = {sev_string, verbosity_str, " ", filename_line_string, "@ ", 
 002630       time_str, ": ", report_object_name, context_str,
 002630       " [", report_message.get_id(), "] ", msg_body_str, terminator_str};
        
          endfunction 
        
          // is report_summarize() in the call stack
%000003   protected bit m_report_summarize_in_stack = 0 ;
        
          // Function --NODOCS-- report_summarize
          //
          // Outputs statistical information on the reports issued by this central report
          // server. This information will be sent to the command line if ~file~ is UVM_STDOUT, or
          // to the file descriptor ~file~ if it is not UVM_STDOUT.
          //
          // The <run_test> method in uvm_top calls this method.
        
%000003   virtual function void report_summarize(UVM_FILE file = UVM_STDOUT);
%000003      m_report_summarize_in_stack = 1 ;
%000003      summarize(file);
%000003      m_report_summarize_in_stack = 0 ;
          endfunction
        
          // @uvm-compat
%000003   virtual function void summarize(UVM_FILE file = UVM_STDOUT);
%000003      if (!m_report_summarize_in_stack) begin
%000000        report_summarize(file);
             end
        
%000003      else begin
%000003        m_report_summarize(file);
             end
        
          endfunction
        
%000003   virtual function void m_report_summarize(UVM_FILE file = UVM_STDOUT);
%000003     string id;
%000003     string name;
%000003     uvm_root root;
%000003     uvm_action action;
            
%000003     string output_str;
%000003     string q[$];
        
%000003     uvm_report_catcher::summarize(file);
%000003     q.push_back("\n--- UVM Report Summary ---\n\n");
        
%000003     if(m_max_quit_count != 0) begin
%000000       if ( m_quit_count >= m_max_quit_count ) begin
                
%000000         q.push_back("Quit count reached!\n");
              end
        
%000000       q.push_back($sformatf("Quit count : %5d of %5d\n",m_quit_count, m_max_quit_count));
            end
        
%000003     q.push_back("** Report counts by severity\n");
~000012     foreach(m_severity_count[s]) begin
 000012       q.push_back($sformatf("%s :%5d\n", s.name(), m_severity_count[s]));
            end
        
%000003     if (enable_report_id_count_summary) begin
%000003       q.push_back("** Report counts by id\n");
~000038       foreach(m_id_count[id]) begin
                
 000038         q.push_back($sformatf("[%s] %5d\n", id, m_id_count[id]));
              end
        
            end
        
%000003     if(file == UVM_STDOUT) begin 
%000003       `uvm_info("UVM/REPORT/SERVER",`UVM_STRING_QUEUE_STREAMING_PACK(q),UVM_NONE)
            end
%000000     else begin
              // Re-route the output for the message to the file by changing the action, restoring to original setting after message reported
%000000       root = uvm_root::get();
%000000       action = root.get_report_action(UVM_INFO, "UVM/REPORT/SERVER");
%000000       root.set_report_id_action("UVM/REPORT/SERVER", UVM_LOG);
%000000       root.set_report_id_file("UVM/REPORT/SERVER", file);
%000000       `uvm_info("UVM/REPORT/SERVER",`UVM_STRING_QUEUE_STREAMING_PACK(q),UVM_NONE)
%000000       root.set_report_id_action("UVM/REPORT/SERVER", action);
            end
          endfunction
        
        endclass
        
        
        `endif // UVM_REPORT_SERVER_SVH
        
